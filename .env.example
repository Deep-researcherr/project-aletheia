# Copy to .env and fill in the keys. Never commit the filled-in file.

# --- CORS ------------------------------------------------------------------
# The frontend normally calls the API with a relative URL, so it is same-origin
# and CORS never applies. Set this only when the frontend is served from a
# DIFFERENT origin than the API -- a Vite dev server on another port, or a
# teammate reaching the app over the LAN.
#
# Comma separated, exact origins. The loopback pattern already allows any port
# on localhost/127.0.0.1, so this is only needed for real hostnames or a LAN IP.
# CORS_ORIGINS=http://192.168.1.50:8000,https://research.internal

# Override the loopback pattern entirely (set empty string to disable).
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- request pacing -------------------------------------------------------
# Free-tier providers do not fail politely: one 429 can cost the rest of the
# day. Spacing calls out bounds the total sent in any window by construction,
# and the concurrency ceiling stops two browser tabs jointly exceeding a quota
# that each would respect on its own.
#
# Turn this off once you are on paid plans with headroom.
#
# Rough cost for a 43-call run: 30/min adds ~1.4 min, 20/min ~2.1 min,
# 12/min ~3.6 min on top of an already ~20 minute run.
THROTTLE_LLM=1
# Ceiling on model calls per minute. 0 disables pacing entirely.
THROTTLE_LLM_PER_MINUTE=12
# Model calls in flight at once. 1 also serialises two concurrent runs.
THROTTLE_LLM_MAX_CONCURRENT=1
# Search already fans out across workers and SerpApi is a metered paid plan,
# so this is off by default. Raise it only if SerpApi starts throttling you.
THROTTLE_SEARCH=0
THROTTLE_SEARCH_PER_MINUTE=60
THROTTLE_SEARCH_MAX_CONCURRENT=4

# --- credentials -----------------------------------------------------------
# Only the providers actually used by the model chain below are listed.
# Add a key only for a provider you have a real account with; an unset key
# makes that model fail on every call and waste a fallback attempt.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
# SERPAPI_KEY is required for web/news/scholar/github search.
SERPAPI_KEY=
# TAVILY_API_KEY enables the paid Tavily extraction fallback for pages the
# direct fetcher cannot read. Leave empty to disable.
TAVILY_API_KEY=
# FIRECRAWL_API_KEY enables the paid Firecrawl fallback, tried after Tavily.
# Leave empty to disable.
FIRECRAWL_API_KEY=
# UNPAYWALL_EMAIL enables Unpaywall open-access lookup (any address works).
# Leave empty to skip Unpaywall in the resolver chain.
UNPAYWALL_EMAIL=
# GITHUB_TOKEN is optional; it only raises GitHub API rate limits.
GITHUB_TOKEN=
# Needed only if you set an nvidia_nim/ model below.
NVIDIA_API_KEY=

# --- model chain -----------------------------------------------------------
# Switching models is a .env-only change: no code edits needed. Set the two
# lines below, restart uvicorn (it loads .env once at boot and --reload does
# not watch it), and the new chain takes effect. Restarting also clears all
# model cooldowns, so a parked model is usable again immediately.
#
# LLM_MODEL is tried first; LLM_FALLBACKS is the comma-separated fallback
# chain, tried in order when a model is unavailable or rate limited.
#
# Every model string MUST carry a litellm provider prefix. A bare model name
# fails with "LLM Provider NOT provided". The prefix is the provider, not
# always the vendor: nvidia models use nvidia_nim/, not nvidia/.
#
# Every model in the chain MUST support JSON mode: the planner, extraction
# and gap-check stages send response_format=json_object, and a model without
# it breaks those stages while report writing looks fine. Verify a new model
# with one plain call and one JSON call before trusting it.
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_FALLBACKS=openrouter/google/gemma-3-27b-it,openrouter/meta-llama/llama-3.3-70b-instruct,openrouter/qwen/qwen3-32b,cohere/command-a-03-2025,cohere/command-r7b-12-2024,groq/llama-3.3-70b-specdec,huggingface/Qwen/Qwen3-4B-Thinking-2507

# Optional per-role overrides, e.g. LLM_MODEL_SYNTH=openrouter/qwen/qwen3-32b
# An override is PREPENDED, not isolated: LLM_MODEL stays second in that
# role's chain. Roles: DEFAULT (planner, gap check), JUDGE (extraction,
# contradiction detection), SYNTH (report writing).
# LLM_MODEL_DEFAULT=
# LLM_MODEL_SYNTH=
# LLM_MODEL_JUDGE=

# --- resilience ------------------------------------------------------------
# Attempts per model before moving to the next one in the chain.
LLM_MAX_ATTEMPTS=2
# How long a model is skipped after a 429, by quota kind.
LLM_DAILY_COOLDOWN_S=3600
LLM_PER_MINUTE_COOLDOWN_S=60
# How long a model is skipped after repeated 5xx / overload.
LLM_OVERLOAD_COOLDOWN_S=30
# How long a model is skipped after rejecting a request as too large for its
# token limit. Long on purpose: the same oversized prompt cannot succeed on that
# model however long you wait, so a short value only produces a retry loop.
LLM_OVERSIZED_COOLDOWN_S=900
# Longest to wait before giving the whole chain one second pass. Used only when
# every model in the chain failed with a temporary rate limit; auth failures
# and oversized prompts fail fast instead of waiting.
# LLM_CHAIN_RETRY_WAIT_S=30

# --- retrieval -------------------------------------------------------------
# Retrieve the real document behind each search result, not just the snippet.
RESEARCH_FETCH=1
# Documents actually downloaded per run.
FETCH_MAX_SOURCES=22
# Ceiling on extra sources pulled in by following references in those documents.
REFERENCES_MAX=6
REFERENCES_PER_SOURCE=3
# Per-document download and text ceilings.
FETCH_MAX_BYTES=4000000
FETCH_MAX_CHARS=400000
FETCH_MAX_PAGES=40
FETCH_TIMEOUT_S=20
FETCH_MAX_WORKERS=6
# Honour robots.txt. Leave this on: the pipeline is a crawler.
FETCH_RESPECT_ROBOTS=1

# --- chunking and relevance ------------------------------------------------
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=2600
CHUNKS_PER_SOURCE=6
RELEVANCE_TOP_CHUNKS=70
RELEVANCE_MIN_SCORE=0

# --- evidence extraction ---------------------------------------------------
# Run the LLM evidence-extraction stage over retrieved passages.
RESEARCH_ANALYZE=1
# Characters of passage text per extraction call. Kept small on purpose: with
# a ~6k-char batch the prompt stays well under Groq's 8,000 TPM window, while
# the old 13k batches blew past it and locked the pipeline in long cooldowns.
EXTRACT_BATCH_CHARS=6000
# Ceiling on extraction calls. Sized so a full 70-chunk ranking (~98k chars at
# 6k per batch ≈ 17 batches) is covered without silently dropping the tail.
EXTRACT_MAX_BATCHES=20
MAX_EVIDENCE_RECORDS=160

# --- report ----------------------------------------------------------------
# deep = full research report; brief = short summary.
REPORT_DEPTH=deep
REPORT_MAX_TOKENS=6000
REPORT_MIN_WORDS=3000
REPORT_MAX_SECTIONS=12
# Evidence records handed to each section writer. Kept selective: the
# top-ranked records carry the section, and a smaller prompt stays clear of
# provider token limits instead of padding citation count.
REPORT_EVIDENCE_PER_SECTION=40

# --- sub-question planning -------------------------------------------------
# Drop sub-questions that restate an earlier one, and ask for replacements.
# Two signals, each with its own threshold: rare-term overlap catches a hard
# restatement, character overlap catches the same question reworded. Measured on
# real plans, a reworded duplicate scores ~0.61 and genuinely distinct dimensions
# score 0.05-0.09, so 0.45 sits in a wide gap. Set either to 1.0 to disable.
PLAN_DEDUP_THRESHOLD=0.70
PLAN_DEDUP_GRAM_THRESHOLD=0.45
# Ask the planner again for replacement sub-questions when duplicates are found.
# If it cannot supply them the surviving plan is used unchanged.
PLAN_DEDUP_REGENERATE=1

# --- incremental analysis --------------------------------------------------
# Skip sources already processed for evidence in an earlier round. A source is
# re-read only when its retrieval grade improves (e.g. snippet-only became a
# real document), so extra rounds cost only their genuinely new material.
ANALYSE_REUSE_SOURCES=1

# --- global budgets --------------------------------------------------------
# Ceilings that keep a run from expanding without limit.
# Leave unset to auto-size (17 + 18 per round). Set it only to pin a ceiling.
# 2 rounds ~ 53 | 4 rounds ~ 89 | 6 rounds ~ 125 | 10 rounds ~ 197
# RESEARCH_LLM_BUDGET=89
RESEARCH_FETCH_BUDGET=28
RESEARCH_MAX_SOURCES=30
# Gap-check loop passes. Each extra round costs roughly 18 more model calls.
# Leave RESEARCH_LLM_BUDGET unset and the budget scales to match; setting it
# too low makes a deep run return a PARTIAL report instead of a deeper one.
# Gap-check loop passes. Each extra round costs roughly 18 more model calls.
# Leave RESEARCH_LLM_BUDGET unset and the budget scales to match; setting it
# too low makes a deep run return a PARTIAL report instead of a deeper one.
RESEARCH_MAX_ROUNDS=2
# Hard ceiling on the above, shared by the API and the depth selector.
RESEARCH_MAX_ROUNDS_LIMIT=10
# Hard ceiling on the above, shared by the API and the depth selector.
RESEARCH_MAX_ROUNDS_LIMIT=10

# --- markdown export -------------------------------------------------------
EXPORT_ENABLED=1
EXPORT_DIR=exports

# --- wikipedia baseline ------------------------------------------------------
# Fetched before any LLM call; zero API cost. Disable if offline.
WIKI_ENABLED=1
WIKI_MAX_DOCS=3
# Title hits kept per Wikipedia search. The baseline searches once for the
# main question and once per planned sub-question, pooling distinct titles.
WIKI_TITLES_PER_QUERY=2
# Token-overlap above which a gap-check follow-up counts as a repeat query.
GAP_DUP_THRESHOLD=0.60
# Durable registry for model cooldowns + learned prompt ceilings.
MODEL_HEALTH_PATH=.cache/model_health.json

# --- output memory pool (final synthesis) ----------------------------------
# Retry model-failed report sections once, grounded in the finished sections
# already in the pool, so a fallback continues the report instead of
# restarting it. Pool entries are immutable and handed out as copies.
OUTPUT_POOL_RESUME=1
OUTPUT_POOL_CONTEXT_CHARS=4000

# --- dev search cache ------------------------------------------------------
# Relative paths resolve against the repo root. Leave unset to disable.
SEARCH_CACHE_DIR=.cache/serp
# Hosts dropped from web/news results (social/video pages the fetcher cannot
# read). Scholar and GitHub are never filtered. Set empty to disable.
# SEARCH_BLOCKED_HOSTS=twitter.com,x.com,facebook.com,instagram.com,tiktok.com,youtube.com,pinterest.com
# Sharpen planner queries with autocomplete phrasing (one cached call each;
# failures keep the original query, so this can never break planning).
SEARCH_EXPAND_QUERIES=1
# Highly-cited papers chased forward for citing documents per run.
SCHOLAR_FORWARD_MAX=2

# --- mock mode (dev/test only, defaults OFF) --------------------------------
# 1 makes the LLM return canned replies; no real model calls are made.
# LLM_MOCK=1
# Force a canned failure for one role, or all: planner|gap|judge|synth|all
# LLM_MOCK_FAIL=synth
# Artificial latency so streaming is visible in the browser (default 400).
# LLM_MOCK_DELAY_MS=400

# 1 makes search return synthetic results; no SerpApi calls are made.
# SEARCH_MOCK=1
# Force a search failure for one source, or all: web|news|scholar|github|all
# SEARCH_MOCK_FAIL=web
# Artificial latency for search results (default 300).
# SEARCH_MOCK_DELAY_MS=300